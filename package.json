{
  "name": "tarkov-map-project",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A clean, modern interactive map site for Escape from Tarkov.",
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "dev": "node scripts/setup-ocr.mjs && vite",
    "build": "node scripts/setup-ocr.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "smoke": "node scripts/smoke.mjs",
    "images": "node scripts/fetch-task-images.mjs",
    "check-quests": "node scripts/check-quests.mjs",
    "task-facts": "node scripts/build-task-facts.mjs",
    "kord-docs": "node scripts/fetch-kord-documents.mjs",
    "quest-prereqs": "node scripts/fetch-quest-prereqs.mjs",
    "setup-ocr": "node scripts/setup-ocr.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.1",
    "leaflet": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
